# MongoDB Atlas connection string
# https://www.mongodb.com/cloud/atlas → Database → Connect → Drivers
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Random secret for login tokens (use 32+ random characters)
JWT_SECRET=change-this-to-a-long-random-secret-string

# Optional: one-time seed via GET /api/setup/ensure-primary?key=...
# SEED_SECRET=your-random-seed-secret

# Point local npm run dev at your live Vercel API (optional):
# VITE_API_URL=https://your-app.vercel.app

# Force browser-only storage during dev (optional):
# VITE_USE_LOCAL=true
